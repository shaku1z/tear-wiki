{
  "name": "tear-wiki",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync:game": "node scripts/sync-game-data.mjs",
    "verify:game": "node scripts/verify-game-data.mjs",
    "verify:tiers": "node scripts/verify-tier-system.mjs",
    "verify:viewer": "node scripts/verify-model-viewer.mjs",
    "verify:terminology": "node scripts/verify-terminology.mjs",
    "test:game-reference": "node --test scripts/game-reference-contract.test.mjs scripts/fetch-game-reference-artifact.test.mjs scripts/sync-canonical-game-reference.test.mjs scripts/modern-reference-components.test.mjs scripts/loadout-planner.test.mjs scripts/model-exhibit.test.mjs",
    "verify:game-reference": "node scripts/sync-canonical-game-reference.mjs",
    "sync:game-reference": "node scripts/sync-canonical-game-reference.mjs --write",
    "verify:game-reference-artifact": "node scripts/store-game-reference.mjs",
    "sync:canonical-game-reference": "node scripts/sync-canonical-game-reference.mjs",
    "fetch:game-reference": "node scripts/fetch-game-reference-artifact.mjs",
    "check:snapshot": "npm run test:game-reference && npm run verify:terminology && npm run verify:game && npm run verify:tiers && npm run verify:viewer && npm run astro -- build && npm run check:modern-reference-pages",
    "check:modern-reference-pages": "node scripts/check-modern-reference-pages.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/starlight": "^0.41.3",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.0.2",
    "sharp": "^0.34.5",
    "svelte": "^5.56.4",
    "yauzl": "3.4.0"
  }
}
