{
  "name": "tear-wiki",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "preview": {
      "name": "tear-wiki-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash"
      }
    }
  }
}
