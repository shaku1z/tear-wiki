---
import { bosses, enemies, source } from '../data/game-reference.mjs';
import { resolveModelReference } from '../data/model-exhibit.mjs';

export interface Props {
  model: string;
  variant?: string;
}

const { model, variant = '' } = Astro.props;
const reference = resolveModelReference(model);
const family = reference.kind === 'enemy' ? enemies.families.find((entry) => entry.id === reference.canonicalId) : null;
const boss = reference.kind === 'boss' ? bosses.find((entry) => entry.id === reference.canonicalId) : null;
const canonicalRecord = family || boss;
const variants = family?.variants || [];
const selectedVariant = variants.find((entry) => entry.id === variant) || null;
const invalidVariant = Boolean(variant) && !selectedVariant;
const displayName = boss?.name || family?.id?.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) || reference.label || model || 'Unknown record';
const recordLabel = boss ? 'CANONICAL BOSS RECORD' : family ? 'CANONICAL ENEMY FAMILY' : reference.kind === 'legacy-label' ? 'LEGACY LABEL / NO CANONICAL FAMILY' : 'UNSUPPORTED RECORD';
const assetPath = reference.assetId ? `/generated/models/${reference.assetId}.svg` : null;
const assetLabel = assetPath ? 'ARCHIVAL SVG / NOT RUNTIME SIMULATION' : 'NO ARCHIVAL ART / METADATA ONLY';
const phaseMarks = boss?.phaseMarks || [];
---

<section class="model-exhibit" data-model-exhibit data-model={model} data-canonical-id={reference.canonicalId || ''}>
  <header class="exhibit-header">
    <div class="exhibit-index" aria-hidden="true"><i></i><span>REFERENCE EXHIBIT</span></div>
    <div class="exhibit-identity">
      <p>{recordLabel}</p>
      <h2>{displayName}</h2>
    </div>
    <div class="exhibit-provenance" title="Validated committed game-reference artifact">
      <span>REFERENCE SOURCE</span><code>{source.sha.slice(0, 7)}</code>
    </div>
  </header>

  <div class="exhibit-stage" aria-label={`${displayName} reference exhibit`}>
    {assetPath ? (
      <img class="archival-silhouette" src={assetPath} alt={`Archival silhouette of ${displayName}`} />
    ) : (
      <div class="no-art" role="status"><strong>NO ARCHIVAL SILHOUETTE</strong><span>This record has no retained artwork.</span></div>
    )}
    <div class="stage-grid" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="stage-label"><span>{assetLabel}</span><b>{reference.canonicalId || 'NO CANONICAL ID'}</b></div>
  </div>

  <div class="exhibit-grid">
    <section class="record-panel" aria-label="Canonical record">
      <span class="panel-label">PUBLISHED CONTRACT</span>
      {canonicalRecord ? (
        <dl class="record-list">
          <div><dt>RECORD ID</dt><dd>{canonicalRecord.id}</dd></div>
          {boss ? <div><dt>STAGE ID</dt><dd>{boss.stageId}</dd></div> : <div><dt>VARIANT ENTRIES</dt><dd>{variants.length}</dd></div>}
          {boss && <div><dt>PHASE MARKS / HP FRACTION</dt><dd>{phaseMarks.map((mark) => `${Math.round(mark * 100)}%`).join(' · ')}</dd></div>}
        </dl>
      ) : (
        <p class="boundary-copy">No canonical family or boss record is published for this viewer prop. The label is retained only so older documentation resolves honestly.</p>
      )}
    </section>

    <section class="variant-panel" aria-label="Published variant records">
      <span class="panel-label">VARIANT RECORDS</span>
      {variants.length ? (
        <>
          <label class="variant-select-label" for={`variant-${model}`}>SELECT PUBLISHED VARIANT
            <select id={`variant-${model}`} data-variant-select>
              <option value="">BASE FAMILY ENTRY</option>
              {variants.map((entry) => <option value={entry.id} selected={entry.id === variant}>{entry.name}</option>)}
            </select>
          </label>
          <div class="variant-records">
            <p data-variant-record="" hidden={Boolean(selectedVariant)}>Base family entry; no variant-specific record selected.</p>
            {variants.map((entry) => (
              <p data-variant-record={entry.id} hidden={entry.id !== variant}>
                <strong>{entry.name}</strong><span>ID {entry.id}</span><span>WEIGHT {entry.weight}</span><span>{entry.minWave == null ? 'BASE POOL' : `UNLOCK WAVE ${entry.minWave}`}</span>
              </p>
            ))}
          </div>
        </>
      ) : (
        <p class="boundary-copy">No variant entries are published for this record.</p>
      )}
      {invalidVariant && <p class="variant-warning" role="status">Requested variant <code>{variant}</code> is not in the published contract; showing the canonical record boundary.</p>}
    </section>
  </div>

  <footer class="exhibit-footer">
    <span>STATIC REFERENCE ONLY</span>
    <span>NO TOTAL/CURRENT HP · HITBOX · AI · PROJECTILE OR RUNTIME SIMULATION DATA PUBLISHED</span>
  </footer>
</section>

<script>
  document.querySelectorAll('[data-model-exhibit]').forEach((root) => {
    const select = root.querySelector('[data-variant-select]');
    const records = [...root.querySelectorAll('[data-variant-record]')];
    if (!select || !records.length) return;
    const applyVariant = (id, updateUrl = true) => {
      if (![...select.options].some((option) => option.value === id)) id = '';
      select.value = id;
      records.forEach((record) => { record.hidden = record.dataset.variantRecord !== id; });
      if (updateUrl) {
        const url = new URL(location.href);
        id ? url.searchParams.set('variant', id) : url.searchParams.delete('variant');
        history.replaceState({}, '', url);
      }
    };
    select.addEventListener('change', () => applyVariant(select.value));
    const requested = new URL(location.href).searchParams.get('variant');
    if (requested && [...select.options].some((option) => option.value === requested)) applyVariant(requested, false);
  });
</script>

<style>
  .model-exhibit { --exhibit-surface: #0a0b0e; --exhibit-raised: #111318; --exhibit-ink: #f5f7f8; --exhibit-muted: #858a92; --exhibit-line: rgba(245,247,248,.16); --exhibit-accent: #13c4d6; background: var(--exhibit-surface); box-shadow: 0 24px 60px rgba(0,0,0,.48); color: var(--exhibit-ink); display: block; margin: 2.5rem 0 3rem; outline: none; }
  .model-exhibit:focus-within { outline: 2px solid var(--exhibit-accent); outline-offset: 4px; }
  .exhibit-header { align-items: stretch; border: 1px solid var(--exhibit-line); display: grid; grid-template-columns: minmax(120px,.7fr) 1.4fr auto; min-height: 96px; }
  .exhibit-index, .exhibit-provenance { align-items: center; color: var(--exhibit-muted); display: flex; font: 700 .62rem/1 var(--sl-font-mono); gap: .65rem; letter-spacing: .15em; padding: 1rem 1.25rem; }
  .exhibit-index { border-right: 1px solid var(--exhibit-line); } .exhibit-index i { background: var(--exhibit-accent); box-shadow: 8px 0 16px var(--exhibit-accent); height: 2px; width: 24px; }
  .exhibit-identity { align-self: center; padding: 1rem 1.4rem; } .exhibit-identity p { color: var(--exhibit-accent); font: 700 .64rem/1 var(--sl-font-mono); letter-spacing: .17em; margin: 0 0 .35rem; } .exhibit-identity h2 { color: var(--exhibit-ink); font: 800 clamp(1.3rem,3vw,2rem)/1 var(--sl-font-mono); letter-spacing: .08em; margin: 0; text-transform: uppercase; }
  .exhibit-provenance { border-left: 1px solid var(--exhibit-line); flex-wrap: wrap; justify-content: flex-end; max-width: 170px; } .exhibit-provenance span::before { background: #1faf5a; box-shadow: 0 0 10px #1faf5a; content: ''; display: inline-block; height: 6px; margin-right: .5rem; width: 6px; } .exhibit-provenance code { background: none; color: var(--exhibit-ink); padding: 0; }
  .exhibit-stage { align-items: center; background: radial-gradient(circle at 50% 46%, rgba(19,196,214,.17), transparent 38%), var(--exhibit-surface); border-inline: 1px solid var(--exhibit-line); display: grid; min-height: clamp(260px,42vw,440px); overflow: hidden; place-items: center; position: relative; }
  .archival-silhouette { height: 100%; max-height: 440px; object-fit: cover; opacity: .76; position: absolute; width: 100%; } .no-art { color: var(--exhibit-muted); display: grid; gap: .55rem; letter-spacing: .12em; place-items: center; position: relative; text-align: center; text-transform: uppercase; z-index: 2; } .no-art strong { color: var(--exhibit-ink); font: 800 1rem/1.2 var(--sl-font-mono); } .no-art span { font: .72rem/1.4 var(--sl-font-mono); }
  .stage-grid { background-image: linear-gradient(rgba(245,247,248,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(245,247,248,.06) 1px,transparent 1px); background-size: 36px 36px; inset: 0; mask-image: linear-gradient(to bottom,transparent,#000 20%,#000 75%,transparent); position: absolute; } .stage-grid i { background: var(--exhibit-accent); opacity: .18; position: absolute; } .stage-grid i:nth-child(1) { height: 48%; left: 22%; top: 26%; width: 1px; } .stage-grid i:nth-child(2) { height: 1px; left: 44%; top: 31%; width: 42%; } .stage-grid i:nth-child(3) { border: 1px solid var(--exhibit-accent); border-radius: 50%; height: 9rem; left: calc(50% - 4.5rem); opacity: .1; top: calc(50% - 4.5rem); width: 9rem; }
  .stage-label { align-items: flex-end; bottom: 1rem; display: flex; flex-direction: column; font: 700 .6rem/1.3 var(--sl-font-mono); gap: .3rem; letter-spacing: .1em; position: absolute; right: 1rem; text-align: right; z-index: 2; } .stage-label span { color: var(--exhibit-muted); } .stage-label b { color: var(--exhibit-accent); }
  .exhibit-grid { border-inline: 1px solid var(--exhibit-line); display: grid; gap: 1px; grid-template-columns: 1fr 1fr; } .record-panel, .variant-panel { background: var(--exhibit-raised); min-width: 0; padding: 1.1rem 1.25rem; } .variant-panel { border-left: 1px solid var(--exhibit-line); } .panel-label { color: var(--exhibit-muted); display: block; font: 700 .6rem/1 var(--sl-font-mono); letter-spacing: .14em; margin-bottom: .9rem; }
  .record-list { margin: 0; } .record-list div { border-bottom: 1px dashed var(--exhibit-line); display: flex; gap: 1rem; justify-content: space-between; padding: .6rem 0; } .record-list div:last-child { border-bottom: 0; } dt { color: var(--exhibit-muted); font: 700 .58rem/1.3 var(--sl-font-mono); letter-spacing: .08em; } dd { color: var(--exhibit-ink); font: 700 .68rem/1.3 var(--sl-font-mono); margin: 0; text-align: right; }
  .variant-select-label { color: var(--exhibit-muted); display: grid; font: 700 .58rem/1.3 var(--sl-font-mono); gap: .45rem; letter-spacing: .08em; } select { background: var(--exhibit-surface); border: 1px solid var(--exhibit-line); border-radius: 0; color: var(--exhibit-ink); font: 700 .7rem/1.3 var(--sl-font-mono); padding: .6rem; } select:focus-visible { border-color: var(--exhibit-accent); outline: 2px solid var(--exhibit-accent); outline-offset: 2px; }
  .variant-records { margin-top: .75rem; } .variant-records p { border-left: 2px solid var(--exhibit-accent); display: flex; flex-wrap: wrap; gap: .45rem .75rem; margin: 0; padding: .55rem .65rem; } .variant-records p[hidden] { display: none; } .variant-records strong { flex-basis: 100%; color: var(--exhibit-ink); font: 800 .78rem/1.2 var(--sl-font-mono); text-transform: uppercase; } .variant-records span { color: var(--exhibit-muted); font: .62rem/1.3 var(--sl-font-mono); } .variant-warning { color: #ef8a17; font: .68rem/1.4 var(--sl-font); margin: .7rem 0 0; } .variant-warning code { color: inherit; }
  .boundary-copy { color: var(--exhibit-muted); font: .76rem/1.5 var(--sl-font); margin: 0; }
  .exhibit-footer { align-items: center; border: 1px solid var(--exhibit-line); border-top: 0; color: var(--exhibit-muted); display: flex; flex-wrap: wrap; font: 700 .58rem/1.3 var(--sl-font-mono); gap: .75rem 1.2rem; justify-content: space-between; letter-spacing: .08em; padding: .75rem 1.25rem; } .exhibit-footer span:first-child { color: var(--exhibit-accent); }
  @media (max-width: 760px) { .exhibit-header { grid-template-columns: 1fr; } .exhibit-index { border-bottom: 1px solid var(--exhibit-line); border-right: 0; } .exhibit-provenance { border-left: 0; border-top: 1px solid var(--exhibit-line); justify-content: flex-start; max-width: none; } .exhibit-grid { grid-template-columns: 1fr; } .variant-panel { border-left: 0; border-top: 1px solid var(--exhibit-line); } .exhibit-footer { align-items: flex-start; flex-direction: column; } }
</style>
