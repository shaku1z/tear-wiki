---
import { modes, source } from '../data/game-reference.mjs';
const links = { campaign:'/modes/adventure', endless:'/modes/endless', gauntlet:'/modes/gauntlet', playground:'/modes/playground' };
---
<section class="mode-directory"><header><span>MODE DIRECTORY</span><code>{source.sha.slice(0, 7)}</code></header><div>{modes.filter((mode) => mode.enabled).map((mode) => { const href = links[mode.id]; const content = <><b>{mode.label}</b><span>{mode.blurb}</span><em>{mode.classification.toUpperCase()}</em></>; return href ? <a class="mode-entry" href={href}>{content}</a> : <div class="mode-entry mode-entry--unlinked">{content}</div>; })}</div></section>
<style>.mode-directory{border:1px solid var(--sl-color-hairline);font-family:var(--sl-font-mono);margin:1.5rem 0}header{background:var(--sl-color-gray-6);border-bottom:1px solid var(--sl-color-hairline);color:var(--sl-color-gray-3);display:flex;font-size:.65rem;font-weight:800;justify-content:space-between;letter-spacing:.1em;padding:.65rem .75rem;text-transform:uppercase}code{color:var(--tear-cyan);font:inherit}.mode-directory>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}.mode-entry{border-bottom:1px solid var(--sl-color-hairline);border-right:1px solid var(--sl-color-hairline);color:inherit;padding:.8rem}.mode-directory a.mode-entry{text-decoration:none}.mode-directory a.mode-entry:hover{background:var(--sl-color-gray-6)}.mode-entry b,.mode-entry span,.mode-entry em{display:block}.mode-entry b{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}.mode-entry span{color:var(--sl-color-gray-3);font-family:var(--sl-font);font-size:.75rem;line-height:1.45;margin-top:.35rem}.mode-entry em{color:var(--tear-cyan);font-size:.6rem;font-style:normal;font-weight:800;letter-spacing:.08em;margin-top:.65rem}.mode-entry--unlinked{opacity:.8}</style>
