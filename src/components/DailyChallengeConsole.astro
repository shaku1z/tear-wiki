---
import { source } from '../data/game-reference.mjs';
---
<section class="daily-console" aria-label="Daily challenge publication status"><header><span>DAILY CHALLENGES / REFERENCE STATUS</span><code>{source.sha.slice(0, 7)}</code></header><div class="boundary-panel"><strong>NOT PUBLISHED IN PUBLIC REFERENCE</strong><p>The live daily schedule, goals, modes, and reward amounts are not included in the validated game-reference artifact. No stale challenge values are reproduced here.</p></div></section>
<style>.daily-console{border:1px solid var(--sl-color-hairline);font-family:var(--sl-font-mono);margin:1.5rem 0}header{background:var(--sl-color-gray-6);border-bottom:1px solid var(--sl-color-hairline);color:var(--sl-color-gray-3);display:flex;font-size:.65rem;font-weight:800;justify-content:space-between;letter-spacing:.1em;padding:.65rem .75rem;text-transform:uppercase}code{color:var(--tear-cyan);font:inherit}.daily-console>div{align-items:stretch;display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr))}.daily-console article{border-bottom:1px solid var(--sl-color-hairline);border-right:1px solid var(--sl-color-hairline);margin:0;padding:.7rem}.daily-console span,.daily-console b,.daily-console em{display:block}.daily-console span{color:var(--sl-color-gray-3);font-size:.62rem}.daily-console b{font-size:1.2rem;margin:.3rem 0}.daily-console em{color:var(--tear-cyan);font-size:.6rem;font-style:normal;font-weight:800;letter-spacing:.06em}.boundary-panel{display:block;padding:1rem}.boundary-panel strong{color:var(--sl-color-white);display:block;font-size:.75rem;letter-spacing:.06em}.boundary-panel p{color:var(--sl-color-gray-3);font-family:var(--sl-font);font-size:.8rem;line-height:1.5;margin:.55rem 0 0;max-width:52rem}</style>
