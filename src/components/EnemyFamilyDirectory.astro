---
import { enemies, source } from '../data/game-reference.mjs';
const pageIds = new Set(['armored', 'bomber', 'charger', 'chimera', 'flyer', 'ranged', 'wraith']);
---
<section class="family-directory"><header><span>ENEMY FAMILY DIRECTORY</span><code>{source.sha.slice(0,7)}</code></header><div>{enemies.families.map((family) => { const content = <><b>{family.id}</b><span>{family.variants.length} published structural variants</span></>; return pageIds.has(family.id) ? <a class="family-entry" href={`/enemies/${family.id}`}>{content}</a> : <div class="family-entry family-entry--unlinked" title="No dedicated wiki page yet">{content}</div>; })}</div></section>
<style>.family-directory{border:1px solid var(--sl-color-hairline);font-family:var(--sl-font-mono);margin:1.5rem 0}header{background:var(--sl-color-gray-6);border-bottom:1px solid var(--sl-color-hairline);color:var(--sl-color-gray-3);display:flex;font-size:.65rem;font-weight:800;justify-content:space-between;letter-spacing:.1em;padding:.65rem .75rem;text-transform:uppercase}code{color:var(--tear-cyan);font:inherit}.family-directory>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.family-entry{border-bottom:1px solid var(--sl-color-hairline);border-right:1px solid var(--sl-color-hairline);color:inherit;display:block;padding:.7rem}.family-directory a.family-entry{text-decoration:none}.family-directory a.family-entry:hover{background:var(--sl-color-gray-6)}.family-entry b{display:block;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}.family-entry span{color:var(--sl-color-gray-3);display:block;font-size:.65rem;margin-top:.35rem}.family-entry--unlinked{opacity:.8}</style>
