---
import { difficulties, weapons } from '../data/game-reference.mjs';

const { path } = Astro.props;
const weaponById = new Map(weapons.map((weapon) => [weapon.id, weapon]));
const difficultyById = new Map(difficulties.map((difficulty) => [difficulty.id, difficulty]));

function resolvePublishedValue(valuePath) {
  const weaponMatch = /^(?:weapon|weapons)\.([a-z0-9-]+)\.tuning\.([A-Za-z][A-Za-z0-9]*)$/.exec(valuePath ?? '');
  if (weaponMatch) {
    const weapon = weaponById.get(weaponMatch[1]);
    const key = weaponMatch[2];
    if (weapon && Object.prototype.hasOwnProperty.call(weapon.tuning, key)) {
      return weapon.tuning[key];
    }
  }

  const difficultyMatch = /^(?:difficulty|difficulties)\.([a-z0-9-]+)\.modifiers\.([A-Za-z][A-Za-z0-9]*)$/.exec(valuePath ?? '');
  if (difficultyMatch) {
    const difficulty = difficultyById.get(difficultyMatch[1]);
    const key = difficultyMatch[2];
    if (difficulty && Object.prototype.hasOwnProperty.call(difficulty.modifiers, key)) {
      return difficulty.modifiers[key];
    }
  }

  return undefined;
}

const value = resolvePublishedValue(path);
const isPublished = value !== undefined;
---

<span class:list={['config-value', { 'is-boundary': !isPublished }]} title={!isPublished ? 'This value is not published in the validated game reference.' : undefined}>
  {isPublished ? value : 'NOT PUBLISHED IN PUBLIC REFERENCE'}
</span>

<style>
  .config-value {
    color: var(--sl-color-accent-high);
    font-weight: bold;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background-color: var(--sl-color-accent-low);
    padding: 0.1em 0.3em;
    border-radius: 4px;
    border: 1px solid var(--sl-color-accent);
  }
  .config-value.is-boundary {
    color: var(--sl-color-gray-2);
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-hairline);
    font-size: .72em;
    letter-spacing: .04em;
  }
</style>
