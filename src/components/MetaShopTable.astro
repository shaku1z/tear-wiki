---
import { source } from '../data/game-reference.mjs';
---

<section class="meta-shop-container" aria-label="Meta shop publication status">
  <header><span>META SHOP / REFERENCE STATUS</span><code>{source.sha.slice(0, 7)}</code></header>
  <div class="boundary-panel">
    <strong>NOT PUBLISHED IN PUBLIC REFERENCE</strong>
    <p>The meta-shop catalog, prices, level progression, and effects are not part of the validated game-reference artifact. No legacy shop values are presented as current.</p>
  </div>
</section>

<style>
  .meta-shop-container { border: 1px solid var(--sl-color-hairline); font-family: var(--sl-font-mono); margin: 1.5rem 0; }
  header { background: var(--sl-color-gray-6); border-bottom: 1px solid var(--sl-color-hairline); color: var(--sl-color-gray-3); display: flex; font-size: .65rem; font-weight: 800; justify-content: space-between; letter-spacing: .1em; padding: .65rem .75rem; text-transform: uppercase; }
  header code { color: var(--tear-cyan); font: inherit; }
  .boundary-panel { padding: 1rem; }
  .boundary-panel strong { color: var(--sl-color-white); display: block; font-size: .75rem; letter-spacing: .06em; }
  .boundary-panel p { color: var(--sl-color-gray-3); font-family: var(--sl-font); font-size: .8rem; line-height: 1.5; margin: .55rem 0 0; max-width: 52rem; }
</style>
